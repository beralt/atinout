#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_build:
	dh_auto_build --builddirectory atinout -- CFLAGS="-W -Wall -Wextra -Werror -DVERSION=\"$(VERSION)\" -g" LDFLAGS=-static atinout.1
	dh_auto_build --builddirectory atinout -- CFLAGS="-W -Wall -Wextra -Werror -DVERSION=\"$(VERSION)\" -g" LDFLAGS=-static

override_dh_auto_install:
	dh_auto_install --builddirectory atinout --destdir debian/sabanto-modem-config
